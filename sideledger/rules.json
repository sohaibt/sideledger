[
{"id": "ledger-ack", "category": "local", "rating": "unknown", "pattern": "^sideledger\\s+ack\\b", "why": "An agent tried to mark its own actions as reviewed."},
{"id": "ledger", "category": "local", "rating": "reversible", "pattern": "^sideledger\\b", "why": "sideledger itself."},
{"id": "migrate-destructive", "category": "database", "rating": "irreversible", "pattern": "^(?:prisma\\s+migrate\\s+reset|prisma\\s+db\\s+push\\s+.*--accept-data-loss|alembic\\s+downgrade|rails\\s+db:(?:drop|reset|rollback|schema:load)|rake\\s+db:(?:drop|reset|rollback|schema:load)|flyway\\s+(?:clean|undo)|supabase\\s+db\\s+reset\\s+.*--linked|sequelize\\s+db:(?:drop|migrate:undo)|knex\\s+migrate:(?:rollback|down)|python[\\d.]*\\s+manage\\.py\\s+flush)\\b", "why": "Drops or rewrites data. Restoring it needs a backup."},
{"id": "migrate", "category": "database", "rating": "unknown", "pattern": "^(?:prisma\\s+(?:migrate|db)\\b|alembic\\s+(?:upgrade|stamp)\\b|rails\\s+db:|rake\\s+db:|flyway\\b|liquibase\\b|supabase\\s+db\\b|sequelize\\s+db:|knex\\s+migrate|drizzle-kit\\s+(?:push|migrate)\\b|dbt\\s+(?:run|seed|snapshot)\\b|python[\\d.]*\\s+manage\\.py\\s+(?:migrate|loaddata)\\b)", "why": "Changes a database schema or data. Which database, and whether it can be undone, is not in the command text."},
{"id": "task-database", "category": "database", "rating": "unknown", "pattern": "^(?:make|just|task|npm\\s+run|pnpm(?:\\s+run)?|yarn(?:\\s+run)?|bun\\s+run)\\s+(?:\\S+\\s+)*?\\S*(?:db[:_-]|migrat|seed)\\S*", "why": "A task named like a database change. Runs a script or program. sideledger reads command text only, so what it does inside is not visible."},
{"id": "task-deploy", "category": "deploy", "rating": "unknown", "pattern": "^(?:make|just|task|npm\\s+run|pnpm(?:\\s+run)?|yarn(?:\\s+run)?|bun\\s+run)\\s+(?:\\S+\\s+)*?\\S*(?:deploy|release|publish|ship|prod)\\S*", "why": "A task named like a deploy. Runs a script or program. sideledger reads command text only, so what it does inside is not visible."},
{"id": "script-database", "category": "database", "rating": "unknown", "pattern": "^(?:(?:bash|sh|zsh|dash|ksh|python[\\d.]*|node|ruby|perl)\\s+)?\\S*(?:migrat|seed)\\S*\\.(?:sh|bash|py|js|mjs|ts|rb|pl)(?:\\s|$)|^\\.?\\.?/\\S*(?:migrat|seed)\\S*", "why": "A script named like a database change. Runs a script or program. sideledger reads command text only, so what it does inside is not visible."},
{"id": "script-deploy", "category": "deploy", "rating": "unknown", "pattern": "^(?:(?:bash|sh|zsh|dash|ksh|python[\\d.]*|node|ruby|perl)\\s+)?\\S*(?:deploy|release|publish)\\S*\\.(?:sh|bash|py|js|mjs|ts|rb|pl)(?:\\s|$)|^\\.?\\.?/\\S*(?:deploy|release|publish)\\S*", "why": "A script named like a deploy. Runs a script or program. sideledger reads command text only, so what it does inside is not visible."},
{"id": "script", "category": "local", "rating": "unknown", "pattern": "^(?:bash|sh|zsh|dash|ksh|source|\\.)(?:\\s|$)|^\\.?\\.?/\\S+|^\\S+\\.(?:sh|bash|py|js|mjs|ts|rb|pl)(?:\\s|$)|^(?:python[\\d.]*|node|ruby|perl|php|deno|tsx|ts-node)(?:\\s+(?!--?(?:version|help|V|v)\\b)|$)", "why": "Runs a script or program. sideledger reads command text only, so what it does inside is not visible."},
{"id": "help", "category": "local", "rating": "reversible", "pattern": "(?:^|\\s)(?:--help|--version|-V)$", "why": "Prints help or a version."},
{"id": "dry-run", "category": "local", "rating": "reversible", "pattern": "\\s--dry-?run\\b(?!=none)", "why": "A dry run changes nothing."},
{"id": "git-push-dry-run", "category": "local", "rating": "reversible", "pattern": "^git(?:\\s+(?:-[Cc]\\s+\\S+|--\\S+))*\\s+push\\b.*\\s-n(?:\\s|$)", "why": "A dry run changes nothing."},
{"id": "git-push-deploy-remote", "category": "deploy", "rating": "irreversible", "pattern": "^git(?:\\s+(?:-[Cc]\\s+\\S+|--\\S+))*\\s+push\\s+(?:-\\S+\\s+)*(?:heroku|dokku|production)\\b", "why": "Pushing to a deploy remote ships it. Live to users once it runs. A rollback restores the code, not what happened while it was live."},
{"id": "git-push-force", "category": "git-push", "rating": "irreversible", "pattern": "^git(?:\\s+(?:-[Cc]\\s+\\S+|--\\S+))*\\s+push\\b.*(?:\\s--force\\b|\\s--force-with-lease\\b|\\s-[a-zA-Z]*f[a-zA-Z]*(?:\\s|$)|\\s\\+\\S+|\\s--delete\\b|\\s-d(?:\\s|$)|\\s--mirror\\b|\\s--prune\\b|\\s:\\S+)", "why": "Overwrites or deletes remote history. Copies held by others may be the only way back."},
{"id": "git-push-protected", "category": "git-push", "rating": "unknown", "pattern": "^git(?:\\s+(?:-[Cc]\\s+\\S+|--\\S+))*\\s+push\\b.*\\s(?:\\S+:)?(?:main|master|prod|production|release|trunk)(?:\\s|$)", "why": "Pushes to a main or release branch, which may trigger CI or a deploy that a revert does not undo."},
{"id": "git-push", "category": "git-push", "rating": "reversible", "pattern": "^git(?:\\s+(?:-[Cc]\\s+\\S+|--\\S+))*\\s+push\\b", "why": "A follow-up commit or branch delete undoes it. Anything CI did because of the push is not undone."},
{"id": "git-local", "category": "local", "rating": "reversible", "pattern": "^git\\b", "why": "Changes only this clone. Effects inside the repo are for your Git diff to show."},
{"id": "gh-merge", "category": "git-push", "rating": "unknown", "pattern": "^gh\\s+pr\\s+merge\\b", "why": "Merges on the remote, which may trigger CI or a deploy."},
{"id": "gh-delete", "category": "network", "rating": "irreversible", "pattern": "^gh\\s+\\S+\\s+delete\\b", "why": "Deletes something on GitHub."},
{"id": "gh-simple", "category": "network", "rating": "reversible", "pattern": "^gh\\s+(?:pr|issue)\\s+(?:view|list|status|checks|diff|create|comment|edit|close|reopen)\\b|^gh\\s+run\\s+(?:view|list|watch)\\b|^gh\\s+workflow\\s+(?:view|list)\\b|^gh\\s+repo\\s+(?:view|list|clone)\\b|^gh\\s+(?:search|browse)\\b|^gh\\s+auth\\s+status\\b", "why": "Reads from GitHub, or posts something that can be edited or closed."},
{"id": "gh-other", "category": "network", "rating": "unknown", "pattern": "^gh\\b", "why": "A GitHub CLI call that is not in the ruleset by name."},
{"id": "package-publish", "category": "package-publish", "rating": "irreversible", "pattern": "^(?:(?:bun|hatch|flit|pdm|dart\\s+pub|flutter\\s+pub|lerna|changeset)\\s+publish\\b|semantic-release\\b|gem\\s+push\\b|dotnet\\s+nuget\\s+push\\b|pod\\s+trunk\\s+push\\b|mvn\\s+(?:\\S+\\s+)*deploy\\b|gradle\\s+publish\\b|podman\\s+push\\b|npm\\s+(?:unpublish|deprecate)\\b)", "why": "Public once it runs. Registries keep or block reused versions, and others may already have it."},
{"id": "deploy-live", "category": "deploy", "rating": "irreversible", "pattern": "^(?:fly\\s+deploy|firebase\\s+deploy|railway\\s+up|kamal\\s+deploy|sam\\s+deploy|cdk\\s+deploy|serverless\\s+deploy|sls\\s+deploy|supabase\\s+functions\\s+deploy|cap\\s+\\S+\\s+deploy)\\b", "why": "Live to users once it runs. A rollback restores the code, not what happened while it was live."},
{"id": "heroku-rollback", "category": "deploy", "rating": "reversible", "pattern": "^heroku\\s+(?:releases:)?rollback\\b", "why": "Returns to an earlier release."},
{"id": "heroku-destroy", "category": "cloud", "rating": "irreversible", "pattern": "^heroku\\s+(?:apps:destroy|pg:reset)\\b", "why": "Deletes an app or its data."},
{"id": "heroku-other", "category": "deploy", "rating": "unknown", "pattern": "^heroku\\b", "why": "A Heroku CLI call that is not in the ruleset by name."},
{"id": "fly-destroy", "category": "cloud", "rating": "irreversible", "pattern": "^fly\\s+(?:\\S+\\s+)*destroy\\b", "why": "Deletes an app or machine."},
{"id": "fly-other", "category": "cloud", "rating": "unknown", "pattern": "^fly\\b", "why": "A Fly CLI call that is not in the ruleset by name."},
{"id": "kubectl-undo", "category": "deploy", "rating": "reversible", "pattern": "^kubectl\\s+rollout\\s+undo\\b", "why": "Returns to the previous rollout."},
{"id": "kubectl-delete", "category": "cloud", "rating": "irreversible", "pattern": "^kubectl\\s+(?:\\S+\\s+)*?(?:delete|drain)\\b", "why": "Removes cluster resources, and any data tied to them."},
{"id": "kubectl-read", "category": "cloud", "rating": "reversible", "pattern": "^kubectl\\s+(?:\\S+\\s+)*?(?:get|describe|logs|top|explain|diff|config|version|api-resources|port-forward)\\b|^kubectl\\s+auth\\s+can-i\\b|^kubectl\\s+rollout\\s+(?:status|history)\\b", "why": "Reads from the cluster."},
{"id": "kubectl-write", "category": "deploy", "rating": "unknown", "pattern": "^kubectl\\b", "why": "Changes the cluster. Which cluster, and whether it can be undone, is not in the command text."},
{"id": "helm-uninstall", "category": "cloud", "rating": "irreversible", "pattern": "^helm\\s+(?:uninstall|delete)\\b", "why": "Removes a release and its resources."},
{"id": "helm-rollback", "category": "deploy", "rating": "reversible", "pattern": "^helm\\s+rollback\\b", "why": "Returns to an earlier release."},
{"id": "helm-read", "category": "cloud", "rating": "reversible", "pattern": "^helm\\s+(?:list|ls|status|get|template|lint|show|search|repo|version)\\b", "why": "Reads only."},
{"id": "helm-write", "category": "deploy", "rating": "unknown", "pattern": "^helm\\b", "why": "Changes a release. Which cluster is not in the command text."},
{"id": "ansible", "category": "deploy", "rating": "unknown", "pattern": "^ansible(?:-playbook)?(?:\\s|$)", "why": "Runs on remote hosts. Runs a script or program. sideledger reads command text only, so what it does inside is not visible."},
{"id": "sql-destructive", "category": "database", "rating": "irreversible", "pattern": "^(?:psql|mysql|mariadb|sqlite3|cockroach|clickhouse-client|bq)\\b.*(?i:\\b(?:DROP\\s+(?:TABLE|DATABASE|SCHEMA|INDEX|VIEW|COLUMN|ROLE|USER)|TRUNCATE|DELETE\\s+FROM|UPDATE\\s+\\S+\\s+SET|ALTER\\s+TABLE\\s+\\S+\\s+DROP)\\b)", "why": "Deletes or overwrites rows. Restoring them needs a backup."},
{"id": "sql-write", "category": "database", "rating": "unknown", "pattern": "^(?:psql|mysql|mariadb|sqlite3|cockroach|clickhouse-client|bq)\\b.*(?i:\\b(?:INSERT\\s+INTO|CREATE\\s+\\S+|ALTER\\s+\\S+|GRANT|REVOKE|MERGE\\s+INTO|REPLACE\\s+INTO|COPY\\s+\\S+\\s+FROM|CALL)\\b)", "why": "Writes to a database. Whether that can be undone depends on what it wrote."},
{"id": "sql-read", "category": "database", "rating": "reversible", "pattern": "^(?:psql|mysql|mariadb|sqlite3|cockroach|clickhouse-client|bq)\\b\\s.*(?i:\\b(?:SELECT|SHOW|DESCRIBE|EXPLAIN)\\b)", "why": "Reads only."},
{"id": "sql-other", "category": "database", "rating": "unknown", "pattern": "^(?:psql|mysql|mariadb|sqlite3|cockroach|clickhouse-client|bq)\\b", "why": "A database client with no visible statement (a file, a pipe or a session)."},
{"id": "db-destructive", "category": "database", "rating": "irreversible", "pattern": "^(?:dropdb|dropuser|pg_restore|mongorestore)\\b", "why": "Drops or replaces a database."},
{"id": "db-safe", "category": "database", "rating": "reversible", "pattern": "^(?:pg_dump|pg_dumpall|mysqldump|mongodump|createdb)\\b", "why": "Reads a database, or creates an empty one."},
{"id": "redis-destructive", "category": "database", "rating": "irreversible", "pattern": "^redis-cli\\b.*(?i:\\s(?:flushall|flushdb|del|unlink|shutdown)\\b)", "why": "Deletes keys."},
{"id": "redis-read", "category": "database", "rating": "reversible", "pattern": "^redis-cli\\b.*(?i:\\s(?:get|mget|hget|hgetall|keys|scan|ping|info|ttl|exists|type|llen|lrange|smembers)\\b)", "why": "Reads only."},
{"id": "redis-other", "category": "database", "rating": "unknown", "pattern": "^redis-cli\\b", "why": "A Redis call that may write."},
{"id": "mongo-destructive", "category": "database", "rating": "irreversible", "pattern": "^mongo(?:sh)?\\b.*(?:\\.drop\\w*\\(|\\.delete(?:One|Many)\\(|\\.remove\\(|dropDatabase)", "why": "Deletes documents or collections."},
{"id": "mongo-other", "category": "database", "rating": "unknown", "pattern": "^mongo(?:sh)?\\b", "why": "A Mongo session with no visible destructive call."},
{"id": "iac-state", "category": "cloud", "rating": "unknown", "pattern": "^(?:terraform|tofu|terragrunt|pulumi)\\b.*\\s(?:state\\s+(?:rm|mv|push)|taint|untaint|import|force-unlock)\\b", "why": "Changes what the tool believes about real infrastructure."},
{"id": "iac-apply", "category": "cloud", "rating": "irreversible", "pattern": "^(?:terraform|tofu|terragrunt|pulumi)\\b\\s+(?:\\S+\\s+)*?(?:destroy|apply|up)\\b", "why": "Changes real infrastructure and can replace stateful resources. Reapplying old config does not bring data back."},
{"id": "iac-read", "category": "local", "rating": "reversible", "pattern": "^(?:terraform|tofu|terragrunt|pulumi)\\b", "why": "Plans or checks only."},
{"id": "cloud-delete", "category": "cloud", "rating": "irreversible", "pattern": "^(?:doctl|hcloud|linode-cli|scw|oci|ibmcloud|eksctl|s3cmd|gsutil|rclone|firebase|railway|render)\\b.*\\s(?:delete|del|rm|rb|destroy|terminate|purge|remove|delete-\\S+)(?:\\s|$)", "why": "Deletes cloud resources."},
{"id": "cloud-read", "category": "cloud", "rating": "reversible", "pattern": "^(?:doctl|hcloud|linode-cli|scw|oci|ibmcloud|eksctl|s3cmd|gsutil|rclone|firebase|railway|render)\\b.*\\s(?:list|ls|get|describe|show|du|cat)(?:\\s|$)", "why": "Reads only."},
{"id": "cloud-other", "category": "cloud", "rating": "unknown", "pattern": "^(?:doctl|hcloud|linode-cli|scw|oci|ibmcloud|eksctl|s3cmd|gsutil|rclone|firebase|railway|render)\\b", "why": "A cloud CLI call that may change something."},
{"id": "http-localhost", "category": "local", "rating": "reversible", "pattern": "^(?:curl|wget|http|xh)\\b.*(?:\\s|/)(?:localhost|127\\.0\\.0\\.1|0\\.0\\.0\\.0|\\[::1\\])(?:[:/\\s]|$)", "why": "Stays on this machine."},
{"id": "http-delete", "category": "network", "rating": "irreversible", "pattern": "^curl\\b.*\\s(?:-[a-zA-Z]*X\\s*|--request[\\s=])DELETE\\b", "why": "Deletes something on a remote server."},
{"id": "http-write", "category": "network", "rating": "unknown", "pattern": "^curl\\b.*\\s(?:-[a-zA-Z]*X\\s*|--request[\\s=])(?:POST|PUT|PATCH)\\b|^curl\\b.*\\s(?:-[a-zA-Z]*[dFT]\\S*|--data\\S*|--form\\S*|--json|--upload-file)(?:[\\s=]|$)|^wget\\b.*\\s--(?:post-data|post-file|method|body-\\S+)\\b", "why": "Sends data to a remote server. What it changes there is not visible."},
{"id": "http-read", "category": "network", "rating": "reversible", "pattern": "^(?:curl|wget)\\b", "why": "A plain download. It tells the server you asked, and changes nothing else that the command shows."},
{"id": "email", "category": "network", "rating": "irreversible", "pattern": "^(?:sendmail|mail|mailx|mutt|swaks)\\b", "why": "An email cannot be taken back."},
{"id": "ssh-destructive", "category": "network", "rating": "irreversible", "pattern": "^ssh\\b.*\\s(?:rm\\s+-\\S*[rRf]|dd\\s|mkfs|shutdown|reboot|DROP\\s+|TRUNCATE\\s)", "why": "Deletes or stops something on a remote host."},
{"id": "rsync-delete", "category": "network", "rating": "irreversible", "pattern": "^rsync\\b.*\\s--delete\\S*.*\\s\\S*[\\w.-]+:\\S*", "why": "Deletes files on the remote host that are not in the source."},
{"id": "copy-remote", "category": "network", "rating": "unknown", "pattern": "^(?:rsync|scp)\\b.*\\s\\S*[\\w.-]+:\\S*", "why": "Copies to or from a remote host, and may overwrite files there."},
{"id": "copy-local", "category": "local", "rating": "reversible", "pattern": "^(?:rsync|scp)\\b", "why": "Copies on this machine."},
{"id": "remote-shell", "category": "network", "rating": "unknown", "pattern": "^(?:ssh|sftp|ftp|telnet|nc|ncat|socat|mosh)\\b", "why": "A session on a remote host. What it does there is not visible."},
{"id": "rm-outside", "category": "local", "rating": "irreversible", "pattern": "^rm\\s+(?:-\\S+\\s+)*-\\S*[rR]\\S*\\s+(?:.*\\s)?(?:~|/(?!tmp/)|\\.\\./|\\$HOME)", "why": "Deletes a folder outside this repo. Git cannot bring it back."},
{"id": "js-tools", "category": "local", "rating": "reversible", "pattern": "^(?:npm|pnpm|yarn|bun)(?:\\s+(?:test|t|install|i|ci|add|remove|uninstall|update|run|exec|list|ls|audit|outdated|init|create|why|pack|version|view|info|link|config|cache|prune|rebuild|start|build|lint|dev)\\b|$)", "why": "A local package or task command."},
{"id": "rust-tools", "category": "local", "rating": "reversible", "pattern": "^cargo\\s+(?:build|test|check|run|clippy|fmt|doc|add|remove|update|tree|bench|clean|init|new|install|metadata|fetch|vendor)\\b", "why": "A local build command."},
