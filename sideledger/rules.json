{"id": "gem-tools", "category": "local", "rating": "reversible", "pattern": "^gem\\s+(?:install|list|build|uninstall|env)\\b", "why": "A local package command."},
{"id": "docker-local", "category": "local", "rating": "reversible", "pattern": "^docker\\s+(?:build|ps|images|logs|inspect|run|exec|stop|start|restart|rm|rmi|pull|compose|network|version|info|stats|top|tag|save|load|cp|kill)\\b|^docker-compose\\b", "why": "Runs on this machine."},
{"id": "known-local", "category": "local", "rating": "reversible", "pattern": "^(?:ls|ll|cat|head|tail|less|more|grep|egrep|fgrep|rg|ag|ack|find|fd|sed|awk|wc|sort|uniq|cut|tr|echo|printf|pwd|cd|pushd|popd|mkdir|rmdir|touch|cp|mv|rm|ln|chmod|chown|date|which|whereis|type|man|true|false|test|\\[|sleep|diff|cmp|jq|yq|tar|zip|unzip|gzip|gunzip|tee|basename|dirname|realpath|stat|file|du|df|ps|top|kill|pkill|lsof|export|unset|set|alias|read|exit|return|wait|local|declare|shift|clear|history|uname|whoami|hostname|id|code|vim|vi|nano|xxd|base64|shasum|md5|md5sum|sha256sum|seq|yes|nl|rev|paste|comm|column|fmt|fold|bc|expr|tree|patch|rustc|rustup|go|gofmt|make|cmake|just|task|tsc|eslint|prettier|ruff|mypy|black|isort|flake8|pylint|pytest|tox|nox|unittest|venv|build|jest|vitest|mocha|playwright|cypress|webpack|vite|rollup|esbuild|next|gcc|g\\+\\+|clang|javac|java|mvn|gradle|swift|xcodebuild|brew|nvm|pyenv|rbenv)(?:\\s|$)", "why": "A local command."},
{"id": "not-in-ruleset", "category": "local", "rating": "unknown", "pattern": ".*", "why": "Not in the ruleset, so sideledger cannot tell what it does."}
]
